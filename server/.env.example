# 复制本文件为 server/.env 后按需修改。
# .env 已被 .gitignore 忽略，不会进仓库；不建 .env 也能跑，
# 但会使用 utils/auth.js 里的兜底默认值（root / 123456 / 公开的默认签名密钥）。
# 部署到公网之前，下面三项务必改掉。

# 后台登录账号
ADMIN_USER=root

# 后台登录密码（请改成自己的强密码）
ADMIN_PASS=change-me

# token 签名密钥：填一串足够长的随机字符。
# 改动后此前签发的所有登录 token 会立即失效（需要重新登录）。
ADMIN_SECRET=change-this-to-a-long-random-secret

# 登录有效期，单位毫秒，默认 7 天
ADMIN_TOKEN_TTL=604800000

# ── 内容存档（npm run archive）──
# 存档推送的目标仓库与分支，默认 origin + 当前分支。
# 想把内容推到私有仓库、而代码仓库保持公开，改这两项即可。
# ARCHIVE_REMOTE=origin
# ARCHIVE_BRANCH=master

# ── 媒体异地同步（npm run sync:media）──
# 目标目录：另一块盘 / 网盘同步目录 / 已挂载的对象存储。不填则同步脚本会提示并退出。
# MEDIA_SYNC_TARGET=D:\backup\worldline
# 要同步哪些目录，逗号分隔。默认只同步 uploads；
# 加上 data/backups 可以连数据库快照一起带走（内容 JSON 走 git，媒体走这里）。
# MEDIA_SYNC_DIRS=uploads,data/backups
# 是否删除目标端多余的文件，默认 false（只增不删，更安全）
# MEDIA_SYNC_DELETE=false
