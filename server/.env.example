# 复制本文件为 server/.env 后按需修改。
# .env 已被 .gitignore 忽略，不会进仓库；不建 .env 也能跑，
# 但会使用 utils/auth.js 里的兜底默认值（root / 123456 / 公开的默认签名密钥）。
# 部署到公网之前，下面三项务必改掉。

# 后台登录账号
ADMIN_USER=root

# 后台登录密码（请改成自己的强密码）
ADMIN_PASS=change-me

# token 签名密钥：填一串足够长的随机字符。
# 改动后此前签发的所有登录 token 会立即失效（需要重新登录）。
ADMIN_SECRET=change-this-to-a-long-random-secret

# 登录有效期，单位毫秒，默认 7 天
ADMIN_TOKEN_TTL=604800000
